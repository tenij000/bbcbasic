10 MODE 0
20 CLG
30 PRINT "LAAD ALIEN IN GEHEUGEN..."
40 DIM S(255)
50 FOR I = 0 TO 255 : READ S(I) : NEXT I
60 C = 1 : REM Startkleur Rood
70 GOSUB 300 : REM Upload de alien naar de FPGA
80 X = 640 : Y = 360
90 DX = 12 : DY = 8 : REM Beweegsnelheid
100 PRINT "DRUK OP EEN TOETS OM TE STARTEN"
110 K = GET
120 CLS
130 REM --- MAIN LOOP ---
140 PLOT 201, X, Y
150 X = X + DX
160 Y = Y + DY
170 REM Randcontrole
180 IF X < 32 OR X > 1240 THEN DX = -DX : GOSUB 300
190 IF Y < 32 OR Y > 680 THEN DY = -DY : GOSUB 300
200 GOTO 140
210 END
300 REM --- Subroutine: Verander kleur en upload sprite ---
310 C = C + 1
320 IF C > 7 THEN C = 1
330 FOR I = 0 TO 255
340 IF S(I) = 1 THEN PLOT 203, I, C ELSE PLOT 203, I, 0
350 NEXT I
360 RETURN
